# Parámetros del despliegue (editar antes de scripts/deploy.sh). Los valores generados van a .env.deploy (ignorado por git).
PREFIX=aa
REGION_A=centralus
REGION_B=canadacentral
REGION_A_NAME="Región A · Central US"
REGION_B_NAME="Región B · Canada Central"
SWA_LOCATION=centralus
# Tamaño de VM: en suscripciones MCAPS los B-series x64 suelen estar restringidos; B2ps_v2 (Arm64, 2 vCPU / 8 GiB) es el más barato con 8 GiB.
VM_SIZE=Standard_B2ps_v2
# server (x64) | server-arm64 (Arm64: tamaños con "p", p. ej. B2ps_v2, D2ps_v5)
VM_IMAGE_SKU=server-arm64
# Trusted Launch (true/false)
TRUSTED_LAUNCH=false
PG_SKU=Standard_B1ms
PG_VERSION=16
PG_ADMIN_USER=aaadmin
ADMIN_USERNAME=azureuser
SHUTDOWN_TIME=2000
TIME_ZONE="Central Standard Time (Mexico)"
# CIDR del operador para SSH (vacío = sin SSH; recomendado en MCAPS)
ALLOW_SSH_FROM=
# Correo para la cuenta ACME de Caddy (vacío = se usa el usuario de `az account show`)
ACME_EMAIL=
# Consola gráfica de Kafka (Kafbat UI) en https://<VM>/kafka-ui/: usuario de basic_auth (la contraseña la genera
# push-bundle.sh en .secrets/kafka_ui_password) y modo solo lectura (true = no deja borrar topics ni mover offsets).
KAFKA_UI_USER=demo
KAFKA_UI_READONLY=true
